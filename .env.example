# EchoTube Environment Variables
# Copy this file to .env and fill in your values

# Discord webhook URLs (comma-separated for multiple servers)
# https://support.discord.com/hc/en-us/articles/228383668
ET_DISCORD_WEBHOOK_URLS=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL_HERE

# YouTube sources (at least one required)
ET_CHANNEL_IDS=UCexample1,UCexample2
# ET_PLAYLIST_IDS=PLexample1,PLexample2

# Keywords to match in video titles
ET_KEYWORDS=minecraft,gaming,tutorial

# Matching mode: "any" (default) or "all"
ET_MATCH_TYPE=any

# Poll frequency in seconds (default: 300)
ET_POLL_INTERVAL_SECONDS=300

# Log level: DEBUG, INFO (default), WARN, ERROR
ET_LOG_LEVEL=INFO

# Persistent cache file (leave empty for memory-only)
ET_CACHE_FILE=/app/cache/videos.json

# Test mode: fetches videos but doesn't post to Discord
# ET_TEST_MODE=true

# Development mode: posts only one video per source
# ET_DEVELOPMENT_MODE=true
